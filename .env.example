# =========================
# POSTGRES
# =========================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=persona

# =========================
# REDIS
# =========================
REDIS_URL=redis://redis:6379

# =========================
# QDRANT
# =========================
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=

# =========================
# GROQ (required for chat + STT)
# =========================
GROQ_API_KEY=

# =========================
# GEMINI (optional, for questions + LLM fallback)
# =========================
GEMINI_API_KEY=

# =========================
# CLOUDFLARE R2 (optional, for file uploads)
# =========================
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_AUDIO_BUCKET=audio-uploads
R2_INGEST_BUCKET=ingestion-uploads

# =========================
# AUTH
# =========================
JWT_SECRET=change-me-to-a-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=72

# =========================
# GOOGLE OAUTH (optional)
# =========================
# Get from Google Cloud Console > APIs & Services > Credentials
# OAuth 2.0 Client ID (Web application)
GOOGLE_CLIENT_ID=

# =========================
# CORS (comma-separated origins)
# =========================
# Must include your deployed frontend URL
CORS_ORIGINS=http://localhost:3002

# =========================
# APP
# =========================
NODE_ENV=development
PORT=8001
RELOAD=true

# =========================
# FRONTEND (set in Railway/Vercel, shown here for reference)
# =========================
NEXT_PUBLIC_API_URL=http://localhost:8001
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=   # same value as GOOGLE_CLIENT_ID above
