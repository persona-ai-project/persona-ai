{
  "name": "persona-ai",
  "version": "1.0.0",
  "private": true,
  "description": "AI-powered persona platform",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "cd apps/web && npm run dev",
    "build": "cd apps/web && npm run build",
    "start": "cd apps/web && npm run start",
    "lint": "cd apps/web && npm run lint",
    "api:lint": "cd services/api && python -m flake8 .",
    "api:test": "cd services/api && python -m pytest tests/ -v"
  }
}
